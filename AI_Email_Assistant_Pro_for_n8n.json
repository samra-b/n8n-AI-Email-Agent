        "messages": {
          "values": [
            {
              "content": "=You are a professional customer support representative.\n\nWrite a professional email reply to the customer's order.\n\nInstructions:\nReturn the email in HTML format only.\n- Use <p> for paragraphs.\n- Use <br> where needed.\n- Do not use Markdown.\n- Do not use \\n.\n- Return only valid HTML.\n- Return ONLY the email body.\n- Do NOT include a subject line.\n- Do NOT include \"Subject:\", \"Re:\", metadata, notes or explanations.\n- Write in a friendly and professional business tone.\n- Use proper paragraphs.\n- Leave one blank line between paragraphs.\n- If the customer's name is available, greet them by name.\n- Otherwise use \"Dear Customer,\".\n- Confirm that the order has been received.\n- Mention that the order is being reviewed.\n- If delivery information is available, include it naturally.\n- If information is missing, do NOT invent details.\n- Never use placeholders like [Product Name] or [Order Number].\n- End exactly like this:\n\nBest regards,\n\nCustomer Support Team\n\nCustomer Email:\n\n{{ $('Gmail Trigger').item.json.text || $('Gmail Trigger').item.json.html }}\n\n"
            }
          ]
        },
        "simplify": false,
        "builtInTools": {},
        "options": {}
